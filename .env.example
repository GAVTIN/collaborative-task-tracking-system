# Copy this file to `.env` and adjust. Every variable is optional in development;
# JWT_SECRET is REQUIRED (32+ characters) when NODE_ENV=production.

# --- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# How many reverse proxies sit in front of the app (nginx, a load balancer...). Needed for correct
# client IPs, which the rate limiter relies on. Leave 0 when running without a proxy.
TRUST_PROXY=0
# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGINS=*

# --- Database -------------------------------------------------------------------
# SQLite file location. The folder is created automatically.
DB_FILE=./data/task-tracker.db

# --- Authentication ---------------------------------------------------------------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=3600
# bcrypt cost factor (higher = slower and safer). 12 is a good default.
BCRYPT_ROUNDS=12

# --- Team invitations ----------------------------------------------------------------
INVITE_TTL_DAYS=7

# --- File uploads -----------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# --- Generative AI (optional) -----------------------------------------------------------
# auto      -> use Anthropic when ANTHROPIC_API_KEY is set, otherwise the offline template (default)
# anthropic -> always use Anthropic (fails with 503 if no key)
# mock      -> always use the offline template (no network, no cost)
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=20000

# --- Rate limiting ----------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL=600   # requests per 15 min per IP, whole API
RATE_LIMIT_AUTH=20       # register/login attempts per 15 min per IP
RATE_LIMIT_AI=10         # AI calls per minute per user
