# Do not run dependency install scripts.
#
# Why: better-sqlite3 ships ready-made native binaries for Windows, macOS and Linux inside its npm package
# and marks itself "gypfile: false", but npm does not record that flag in package-lock.json. Without this
# setting, `npm install` / `npm ci` from the lockfile wrongly tries to COMPILE it with node-gyp, which needs
# Python, a C++ toolchain and a download of the Node headers, and fails on machines without them.
#
# None of this project's dependencies need an install script, so skipping them is safe (and is a good
# supply-chain practice in general). `npm start`, `npm test` and `npm run <script>` are unaffected.
#
# Only if you run on a platform that better-sqlite3 has no bundled binary for (for example 32-bit ARM),
# delete the line below and install a C++ toolchain so it can be built from source.
ignore-scripts=true
